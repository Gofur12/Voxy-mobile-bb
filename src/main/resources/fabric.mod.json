{
  "schemaVersion": 1,
  "id": "voxy",
  "version": "${version}",
  "custom": {
    "commit": "${commit}",
    "buildtime": "${buildtime}"
  },
  "name": "Voxy",
  "description": "Far distance rendering mod utilising LoDs",
  "authors": [
    "Cortex"
  ],
  "contact": {
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/voxy/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.cortex.voxy.client.VoxyClient"
    ],
    "modmenu": [
      ${modmenu_entrypoint}
    ],
    "sodium:config_api_user": [
      ${sodium_config_entrypoint}
    ],
    "main": [
      "me.cortex.voxy.commonImpl.VoxyCommon"
    ]
  },
  "mixins": [
    {
      "config": "${client_mixin_config}",
      "environment": "client"
    },
    "${common_mixin_config}"
  ],
  "depends": {
    "minecraft": "${allowed_mc_version}",
    "fabricloader": ">=0.14.22",
    "fabric-api": ">=0.91.1",
    "sodium": "${allowed_sodium_versions}"
  },
  "breaks": {
    "iris": ">=1.12-",
    "voxyworldgenv2": "=2.2.2"
  },
  "accessWidener": "${access_widener}"
}
